{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "paths": {
      "#cds-models/*": [
        "./@cds-models/*"
      ],
      "@sap/cds": [
        "./node_modules/@cap-js/cds-types/dist/cds-types"
      ]
    }
  },
  "include": [
    "srv/**/*.ts",
    "scripts/**/*.ts"
  ]
}