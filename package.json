{
  "name": "sales-order-agent",
  "version": "1.0.0",
  "private": true,
  "description": "PoC SIT 2026: agente A2A para ordens de venda bloqueadas (S/4HANA) integrado a Joule",
  "dependencies": {
    "@a2a-js/sdk": "0.3.10",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@sap-ai-sdk/langchain": "^2.8.0",
    "@sap-ai-sdk/orchestration": "^2.8.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap/cds": "^9.7.1",
    "@sap/xssec": "^4",
    "express": "^5.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.25.2"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds-tsx watch",
    "watch": "cds-tsx watch --profile hybrid",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate-joule.ts",
    "build:mta": "mbt build",
    "deploy": "mbt build && cf deploy mta_archives/sales-order-agent_1.0.0.mtar"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[hybrid]": {
          "kind": "xsuaa"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
