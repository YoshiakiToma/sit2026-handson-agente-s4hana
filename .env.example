# Copie para .env:  cp .env.example .env
DATA_MODE=mock
MODEL_NAME=gpt-4.1

# Opcao A (LLM real): rode  npx tsx scripts/aicore-to-env.ts ~/Downloads/aicore-key.json
#   (o script grava a linha abaixo e desliga o LLM_MODE=fake)
# AICORE_SERVICE_KEY={"serviceurls":{"AI_API_URL":"https://..."},"clientid":"...","clientsecret":"...","url":"https://..."}

# Opcao B (sem AI Core): modelo roteirizado, responde sempre do mesmo jeito
LLM_MODE=fake

